# Copy to .env and fill in (Milestone 2 — only needed for pipeline.mode: real).
# Never commit the real .env — it's already in .gitignore.

ASSEMBLYAI_API_KEY=
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=

# Telegram bot for the booth Pi (church-translator-bot, see PI_SETUP.md).
# Token from @BotFather. Allowed ids: comma-separated numeric Telegram user
# ids — message the bot once and it replies with yours.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
